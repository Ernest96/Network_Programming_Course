<Project Sdk="Microsoft.NET.Sdk">

  <!-- The client of Ex04: a separate program, so it can run next to the server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Ex04_Client</RootNamespace>
    <AssemblyName>Ex04_Client</AssemblyName>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

</Project>
