<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>CatDemo</RootNamespace>
    <AssemblyName>CatDemo</AssemblyName>

    <!-- Deliberately off: students should see every using they depend on. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Avalonia: one desktop UI for Windows, macOS and Linux. Rider restores it from NuGet. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="cat.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
