<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      Must match a .NET runtime you actually have installed.
      See Module 1 for the long version of this warning.
    -->
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Module3</RootNamespace>
    <AssemblyName>Module3.AsyncQueues</AssemblyName>

    <!-- Deliberately off: students should see every using they depend on. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- CatDemo/ is a separate project (a desktop app) - keep its files out of this one. -->
  <ItemGroup>
    <Compile Remove="CatDemo/**" />
    <None Remove="CatDemo/**" />
  </ItemGroup>

  <!-- Ex01b reads data.txt - copy it next to the program. -->
  <ItemGroup>
    <None Update="data.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
