<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      Must match a .NET runtime you actually have installed.
      See Module 1 for the long version of this warning.
    -->
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Module7</RootNamespace>
    <AssemblyName>Module7.Http</AssemblyName>

    <!-- Deliberately off: students should see every using they depend on. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- JSON: the Newtonsoft.Json package from NuGet, as in Module 5 (Ex02 reads the id of the new student). -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- StudentsServer and RiddleServer are separate projects (our own APIs) - keep their files out of this one. -->
  <ItemGroup>
    <Compile Remove="StudentsServer/**" />
    <None Remove="StudentsServer/**" />
    <Compile Remove="RiddleServer/**" />
    <None Remove="RiddleServer/**" />
    <EmbeddedResource Remove="RiddleServer/**" />
  </ItemGroup>

</Project>
